# Copiar a .env antes de levantar el producto:  cp .env.example .env
# Credenciales locales de desarrollo; cámbielas si expone los puertos fuera de su equipo.

# Base de datos del producto
APP_DB_USER=novamercado
APP_DB_PASSWORD=cambiar-esta-clave
APP_DB_NAME=novamercado

# Base de datos de Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar-esta-clave
AIRFLOW_DB_NAME=airflow

# Usuario administrador de Airflow (lo usa también la API para disparar el DAG)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar-esta-clave
AIRFLOW_JWT_SECRET=cambiar-este-secreto

# Solo en Linux: uid del usuario dueño del repositorio (echo $(id -u))
AIRFLOW_UID=50000
