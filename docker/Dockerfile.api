# Imagen de la API y del inicializador. El modelo no va en la imagen: se descarga del
# Model Registry (alias @champion) y se guarda en una cache en volumen.
FROM python:3.12.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY config/ config/
COPY src/ src/
ENV PYTHONPATH=/app/src \
    PARAMS_PATH=/app/config/params.yaml \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 app && mkdir -p /cache && chown app /cache
USER app
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health', timeout=4)" || exit 1

CMD ["uvicorn", "novamercado.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
